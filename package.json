{
  "name": "issuedigest", "private": true, "version": "0.0.0", "type": "module",
  "workspaces": ["apps/web", "packages/api-client"],
  "engines": {"node": "24.21.0", "npm": "11.19.0"},
  "packageManager": "npm@11.19.0",
  "scripts": {
    "setup": "uv sync --locked --all-packages",
    "dev": "node scripts/dev.mjs",
    "dev:api": "uv run --package issuedigest-api uvicorn issuedigest_api.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:web": "npm run dev --workspace @issuedigest/web",
    "lint": "eslint .",
    "lint:python": "uv run ruff check . && uv run ruff format --check .",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:python": "uv run mypy",
    "test": "vitest run",
    "test:python": "uv run pytest",
    "build": "npm run build --workspace @issuedigest/web",
    "contract:generate": "uv run --package issuedigest-api python scripts/export_openapi.py && openapi-typescript packages/api-client/openapi.json -o packages/api-client/src/schema.d.ts",
    "contract:check": "node scripts/check-contract.mjs",
    "check": "npm run lint:python && npm run typecheck:python && npm run test:python && npm run lint && npm run typecheck && npm test && npm run build && npm run contract:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1", "@testing-library/dom": "10.4.2", "@testing-library/jest-dom": "7.0.1", "@testing-library/react": "16.3.3", "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2", "@types/react": "19.3.0", "@types/react-dom": "19.3.0",
    "eslint": "10.12.0", "jsdom": "30.1.2", "openapi-typescript": "7.13.0", "typescript": "5.9.3", "typescript-eslint": "8.71.1", "vitest": "5.0.3"
  }
}
