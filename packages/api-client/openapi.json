            "default": null,
            "title": "Value"
          },
          "workspace_id": {
            "format": "uuid4",
            "title": "Workspace Id",
            "type": "string"
          }
        },
        "required": [
          "observation_id",
          "workspace_id",
          "context",
          "citation_ids"
