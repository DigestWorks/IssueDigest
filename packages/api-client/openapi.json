            "const": "document",
            "default": "document",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "document_id"
        ],
        "title": "DocumentReference",
        "type": "object"
      },
      "DocumentVersion": {
        "additionalProperties": false,
        "properties": {
          "collected_at": {
            "format": "date-time",
            "title": "Collected At",
            "type": "string"
          },
          "document_id": {
            "format": "uuid4",
            "title": "Document Id",
            "type": "string"
          },
          "media_type": {
            "title": "Media Type",
            "type": "string"
          },
          "raw_object_id": {
            "format": "uuid4",
            "title": "Raw Object Id",
            "type": "string"
          },
          "raw_sha256": {
            "pattern": "^[0-9a-f]{64}$",
