{
  "components": {
    "schemas": {
      "Citation": {
        "additionalProperties": false,
        "properties": {
          "citation_id": {
            "format": "uuid4",
            "title": "Citation Id",
            "type": "string"
          },
          "document_version_id": {
            "format": "uuid4",
            "title": "Document Version Id",
            "type": "string"
          },
          "representation_id": {
            "format": "uuid4",
            "title": "Representation Id",
            "type": "string"
          },
          "selector": {
            "discriminator": {
              "mapping": {
                "pdf": "#/components/schemas/PdfQuoteSelector",
                "table_cell": "#/components/schemas/TableCellSelector",
                "text": "#/components/schemas/TextQuoteSelector"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/TextQuoteSelector"
              },
              {
                "$ref": "#/components/schemas/PdfQuoteSelector"
              },
              {
                "$ref": "#/components/schemas/TableCellSelector"
              }
            ],
            "title": "Selector"
          }
        },
        "required": [
          "citation_id",
          "document_version_id",
          "representation_id",
          "selector"
        ],
        "title": "Citation",
        "type": "object"
      },
      "CitationAnchorValidation": {
        "additionalProperties": false,
        "properties": {
          "anchor_status": {
            "const": "matched",
            "default": "matched",
            "title": "Anchor Status",
            "type": "string"
          },
          "citation_id": {
            "format": "uuid4",
            "title": "Citation Id",
            "type": "string"
          },
          "support_status": {
            "const": "not_evaluated",
            "default": "not_evaluated",
            "title": "Support Status",
            "type": "string"
          }
        },
        "required": [
          "citation_id"
        ],
        "title": "CitationAnchorValidation",
        "type": "object"
      },
      "Claim": {
        "additionalProperties": false,
        "properties": {
          "basis": {
            "enum": [
              "source_assertion",
              "observation",
              "inference"
            ],
            "title": "Basis",
            "type": "string"
          },
          "citation_ids": {
            "items": {
              "format": "uuid4",
              "type": "string"
            },
            "minItems": 1,
            "title": "Citation Ids",
            "type": "array"
          },
          "claim_id": {
            "format": "uuid4",
            "title": "Claim Id",
            "type": "string"
          },
          "derivation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DerivationRecord"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "raw_event_time_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Raw Event Time Text"
          },
          "speaker_entity_id": {
            "anyOf": [
              {
                "format": "uuid4",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Speaker Entity Id"
          },
          "subject_entity_ids": {
            "default": [],
            "items": {
              "format": "uuid4",
              "type": "string"
            },
            "title": "Subject Entity Ids",
            "type": "array"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "valid_period": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DateInterval"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "workspace_id": {
            "format": "uuid4",
            "title": "Workspace Id",
            "type": "string"
          }
        },
        "required": [
          "claim_id",
          "workspace_id",
          "text",
          "basis",
          "citation_ids"
        ],
        "title": "Claim",
        "type": "object"
      },
      "ClaimReference": {
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "format": "uuid4",
            "title": "Claim Id",
            "type": "string"
          },
          "kind": {
            "const": "claim",
            "default": "claim",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "claim_id"
        ],
        "title": "ClaimReference",
        "type": "object"
      },
      "ComparisonAssessment": {
        "additionalProperties": false,
        "properties": {
          "aggregation_status": {
            "const": "not_evaluated",
            "default": "not_evaluated",
            "title": "Aggregation Status",
            "type": "string"
          },
          "observation_ids": {
            "items": {
              "format": "uuid4",
              "type": "string"
            },
            "minItems": 2,
            "title": "Observation Ids",
            "type": "array"
          },
          "policy_version": {
            "const": "issuedigest-comparison-v1",
            "default": "issuedigest-comparison-v1",
            "title": "Policy Version",
            "type": "string"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/ComparisonReason"
            },
            "title": "Reasons",
            "type": "array"
          },
          "status": {
            "enum": [
              "same_context",
              "different_context",
              "insufficient_context"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "observation_ids",
          "status",
          "reasons"
        ],
        "title": "ComparisonAssessment",
        "type": "object"
      },
      "ComparisonContext": {
        "additionalProperties": false,
        "properties": {
          "denominator": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Denominator"
          },
          "dimensions": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Dimension"
            },
            "title": "Dimensions",
            "type": "array"
          },
          "geography": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Geography"
          },
          "methodology": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Methodology"
          },
          "metric": {
            "title": "Metric",
            "type": "string"
          },
          "period": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DateInterval"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "population": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Population"
          },
          "question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Question"
          },
          "sample_size": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Sample Size"
          },
          "series_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Series Id"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Unit"
          },
          "weighting": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Weighting"
          }
        },
        "required": [
          "metric"
        ],
        "title": "ComparisonContext",
        "type": "object"
      },
      "ComparisonReason": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "enum": [
              "metric",
              "unit",
              "period",
              "population",
              "geography",
              "question",
              "methodology",
              "sample_size",
              "weighting",
              "denominator",
              "series_id",
              "dimensions",
              "value"
