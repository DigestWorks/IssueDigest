            "title": "Field",
            "type": "string"
          },
          "kind": {
            "enum": [
              "different",
              "missing"
            ],
            "title": "Kind",
            "type": "string"
          },
          "observation_ids": {
            "items": {
              "format": "uuid4",
              "type": "string"
            },
            "minItems": 1,
            "title": "Observation Ids",
            "type": "array"
          }
        },
        "required": [
          "field",
          "kind",
          "observation_ids"
        ],
        "title": "ComparisonReason",
        "type": "object"
      },
      "DateInterval": {
        "additionalProperties": false,
        "properties": {
          "end_date": {
            "format": "date",
