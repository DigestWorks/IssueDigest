        ],
        "title": "Liveness",
        "type": "object"
      },
      "NormalizedBox": {
        "additionalProperties": false,
        "description": "Coordinates after crop/rotation, measured from displayed page top-left.",
        "properties": {
          "x0": {
            "maximum": 1,
            "minimum": 0,
            "title": "X0",
            "type": "number"
          },
          "x1": {
            "maximum": 1,
            "minimum": 0,
            "title": "X1",
            "type": "number"
          },
          "y0": {
            "maximum": 1,
            "minimum": 0,
            "title": "Y0",
            "type": "number"
          },
          "y1": {
            "maximum": 1,
            "minimum": 0,
            "title": "Y1",
            "type": "number"
          }
        },
        "required": [
          "x0",
          "y0",
          "x1",
          "y1"
        ],
        "title": "NormalizedBox",
        "type": "object"
      },
